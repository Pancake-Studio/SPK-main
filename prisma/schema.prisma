// School Productivity Kits — Prisma schema
//
// Local dev uses SQLite (zero-setup, browse with `npm run db:studio`).
// For production PostgreSQL, change `provider` below to "postgresql" and point
// DATABASE_URL at your managed Postgres. The schema is written to be portable:
//  - role/status/type are stored as strings (validated in app via Zod), not
//    native DB enums, so the same schema compiles on SQLite and Postgres.
//  - no scalar-list (`String[]`) columns, which SQLite does not support.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Authentication principal. One row per person who can log in.
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String? // null for OAuth-only users
  role           String    @default("STUDENT") // ADMIN | TEACHER | STUDENT
  name           String
  avatarUrl      String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  teacher        Teacher?
  student        Student?
  accounts       Account[]
  sessions       Session[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  announcements  Announcement[] @relation("AnnouncementAuthor")
  swapDecisions  SwapRequest[]  @relation("SwapDecidedBy")
  swapLogs       SwapLog[]      @relation("SwapLogActor")
  pushSubscriptions PushSubscription[]

  @@index([role])
}

/// Web Push subscription (one per browser/device the user enabled). Used to
/// deliver OS-level notifications even when the app/tab is closed.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Auth.js account (links a User to an OAuth provider).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// Auth.js session (used when session strategy is "database"; kept for compatibility).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Teacher profile (1:1 with a User whose role = TEACHER).
model Teacher {
  id          String  @id @default(cuid())
  userId      String  @unique
  teacherCode String  @unique
  title       String? // Mr. / Mrs. / Ms. / Dr.
  department  String?
  phone       String?
  // ครูที่ปรึกษา: the homeroom class this teacher advises. A class may have
  // multiple advisors, and each advisor manages students in that class.
  advisorClassId String?

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  advisorClass Class? @relation("ClassAdvisor", fields: [advisorClassId], references: [id])

  schedules            Schedule[]
  ownedSubjects        Subject[]     @relation("SubjectOwner")
  swapRequestsMade     SwapRequest[] @relation("SwapRequester")
  swapRequestsReceived SwapRequest[] @relation("SwapTarget")
  delegationsMade      Delegation[]  @relation("DelegationFrom")
  delegationsReceived  Delegation[]  @relation("DelegationTo")
  assignments          Assignment[]

  @@index([department])
}

/// Student profile (1:1 with a User whose role = STUDENT).
model Student {
  id          String  @id @default(cuid())
  userId      String  @unique
  studentCode String  @unique
  title       String? // เด็กชาย / เด็กหญิง / นาย / นางสาว
  rollNumber  Int? // เลขที่ในห้อง — duplicates allowed, highlighted in red in the UI
  classId     String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id])

  submissions   AssignmentSubmission[]
  personalTodos PersonalTodo[]

  @@index([classId, rollNumber])
  @@index([classId])
}

/// Homeroom class group, e.g. "M.4/1".
model Class {
  id         String  @id @default(cuid())
  className  String  @unique
  gradeLevel String
  room       String?

  students    Student[]
  schedules   Schedule[]
  assignments Assignment[]
  advisors    Teacher[] @relation("ClassAdvisor")

  @@index([gradeLevel])
}

/// Academic subject, e.g. "Mathematics" / "MATH101".
model Subject {
  id          String  @id @default(cuid())
  subjectName String
  subjectCode String  @unique
  colorHex    String? // optional accent for timetable cells
  // วิชาที่สอนหลายคน: ซ่อนชื่อครูผู้สอนจากตารางเรียนฝั่งนักเรียน
  hideTeacherForStudents Boolean @default(false)
  // วิชาของครู: when a teacher creates a subject it is "owned" by them and only
  // they (or an admin) may edit it. Admin-created subjects have a null owner.
  ownerTeacherId String?

  owner     Teacher?   @relation("SubjectOwner", fields: [ownerTeacherId], references: [id])
  schedules Schedule[]

  @@index([ownerTeacherId])
}

/// A school-wide activity period (e.g. คาบชุมนุม, คาบอบรมคุณธรรม) — the SAME for
/// every class and every teacher at a given weekday + period. No per-class
/// subject/teacher rows; it is overlaid onto all timetables at read time.
model ActivityPeriod {
  id        String   @id @default(cuid())
  day       String // MON | TUE | WED | THU | FRI
  period    Int
  label     String
  colorHex  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([day, period])
  @@index([day, period])
}

/// A single timetable slot: which teacher teaches which subject to which class
/// on a given weekday + period. This is the unit that period-swaps exchange.
model Schedule {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  teacherId String
  day       String // MON | TUE | WED | THU | FRI
  period    Int
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  swapsAsSource SwapRequest[] @relation("SwapSourceSchedule")
  swapsAsTarget SwapRequest[] @relation("SwapTargetSchedule")
  delegations   Delegation[]

  // Normally one lesson per class+day+period, but a "multi-teacher" subject
  // (Subject.hideTeacherForStudents) may be co-taught — several teachers on the
  // same class slot. So uniqueness includes the teacher; the app layer still
  // blocks two DIFFERENT subjects in one class slot.
  @@unique([classId, day, period, teacherId])
  @@index([classId, day, period])
  @@index([teacherId, day, period])
  @@index([day, period])
}

/// Teacher period-swap request (the core feature) — TEMPORARY, one week only.
/// Non-destructive: the base `Schedule` is never mutated. An APPROVED swap is an
/// overlay applied at read-time ONLY for the week given by `weekStart` (the
/// Monday of the affected week), then it naturally stops applying next week.
/// Both periods belong to the SAME class; both teachers must be free at each
/// other's target time (validated on create).
model SwapRequest {
  id               String   @id @default(cuid())
  requesterId      String
  targetTeacherId  String
  sourceScheduleId String
  targetScheduleId String
  weekStart        String?  // Monday "YYYY-MM-DD" of the week this swap applies to
  reason           String?
  status           String   @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED | CANCEL_REQUESTED | REVERTED
  decidedById      String?
  respondedAt      DateTime?
  // Cancellation of an already-approved swap (#1): one participant requests,
  // the other approves → schedules revert. Teacher ids stored as plain strings.
  cancelRequestedById String?
  cancelDecidedById   String?
  cancelRespondedAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  requester      Teacher  @relation("SwapRequester", fields: [requesterId], references: [id])
  targetTeacher  Teacher  @relation("SwapTarget", fields: [targetTeacherId], references: [id])
  sourceSchedule Schedule @relation("SwapSourceSchedule", fields: [sourceScheduleId], references: [id])
  targetSchedule Schedule @relation("SwapTargetSchedule", fields: [targetScheduleId], references: [id])
  decidedBy      User?    @relation("SwapDecidedBy", fields: [decidedById], references: [id])

  logs SwapLog[]

  @@index([requesterId])
  @@index([targetTeacherId])
  @@index([status])
  @@index([weekStart])
}

/// Period delegation ("ฝากคาบ") for ONE week — TEMPORARY. The owning teacher
/// hands a single period to a covering teacher (who must be free at that time)
/// WITHOUT swapping anything. Non-destructive: the base `Schedule` is untouched;
/// the cover is applied as a read-time overlay only for `weekStart`'s week, then
/// reverts. Shown in the owner's, the cover's, and the class's timetable.
model Delegation {
  id            String   @id @default(cuid())
  weekStart     String   // Monday "YYYY-MM-DD" of the week this applies to
  scheduleId    String   // the period being covered
  fromTeacherId String   // owner of the period
  toTeacherId   String   // covering teacher (free at that time)
  reason        String?
  status        String   @default("ACTIVE") // ACTIVE | DECLINED | CANCELLED
  createdAt     DateTime @default(now())

  schedule    Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  fromTeacher Teacher  @relation("DelegationFrom", fields: [fromTeacherId], references: [id])
  toTeacher   Teacher  @relation("DelegationTo", fields: [toTeacherId], references: [id])

  @@index([weekStart])
  @@index([scheduleId])
  @@index([toTeacherId])
  @@index([fromTeacherId])
}

/// Immutable audit trail for swaps: who did what, with before/after snapshots.
model SwapLog {
  id            String   @id @default(cuid())
  swapRequestId String
  action        String // CREATED | APPROVED | REJECTED | CANCELLED
  actorId       String?
  beforeJson    String? // JSON snapshot of the two schedule slots before
  afterJson     String? // JSON snapshot after
  createdAt     DateTime @default(now())

  swapRequest SwapRequest @relation(fields: [swapRequestId], references: [id], onDelete: Cascade)
  actor       User?       @relation("SwapLogActor", fields: [actorId], references: [id])

  @@index([swapRequestId])
}

/// In-app notification (real-time delivery layered on top via SSE/WebSocket).
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // SWAP_REQUEST | SWAP_APPROVED | ... | EMERGENCY
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

/// School-wide / role-targeted announcement broadcast by an admin.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  audience  String   @default("ALL") // ALL | TEACHERS | STUDENTS
  isUrgent  Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())

  author User @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  @@index([audience])
  @@index([createdAt])
}

/// A named bell-schedule template: the ordered list of daily time slots
/// (home room, class periods, breaks, lunch) shared by every classroom.
/// Exactly one row is `isDefault` = the standard school-wide schedule; other
/// rows are alternate templates (e.g. sports day, exam day) that an admin can
/// pin to a specific calendar date via `ScheduleOverride`.
model BellSchedule {
  id        String     @id @default(cuid())
  name      String
  isDefault Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  slots     BellSlot[]
  overrides ScheduleOverride[]

  @@index([isDefault])
}

/// One row in a bell schedule's day. `kind` distinguishes teaching periods
/// from non-teaching rows (home room / breaks / lunch). Times are stored
/// explicitly (denormalised) for trivial rendering + "current period" lookups,
/// and re-chained from `order` whenever slots are reordered/swapped.
/// `periodNumber` is set only for CLASS rows and is what `Schedule.period`
/// references — it stays attached to the slot as it moves, so swapping two
/// periods moves the lessons (looked up by periodNumber) with the time block.
model BellSlot {
  id           String  @id @default(cuid())
  scheduleId   String
  order        Int
  kind         String  // HOMEROOM | CLASS | BREAK | LUNCH
  label        String
  startTime    String  // "HH:MM" 24h
  endTime      String  // "HH:MM" 24h
  periodNumber Int?    // CLASS rows only

  schedule BellSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

/// Pins a specific calendar date to a (usually alternate) bell schedule, so a
/// day can temporarily use different times / period ordering without touching
/// the default template. Cleared automatically once the date passes (the app
/// only reads overrides for today/future).
model ScheduleOverride {
  id             String   @id @default(cuid())
  date           String   @unique // "YYYY-MM-DD" (local school date)
  bellScheduleId String
  note           String?
  createdAt      DateTime @default(now())

  bellSchedule BellSchedule @relation(fields: [bellScheduleId], references: [id], onDelete: Cascade)

  @@index([date])
}

/// Whole-day timetable swap for ONE specific week (temporary). e.g. "this week,
/// Monday and Tuesday are exchanged" → on that Monday every class follows its
/// Tuesday schedule and vice-versa, then it reverts next week. School-wide.
/// `weekStart` is the Monday (YYYY-MM-DD) of the affected week; `dayA`/`dayB`
/// are the two weekdays exchanged. A weekday appears in at most one swap/week.
model DaySwap {
  id        String   @id @default(cuid())
  weekStart String // Monday of the week, "YYYY-MM-DD"
  dayA      String // MON..FRI
  dayB      String // MON..FRI
  note      String?
  createdAt DateTime @default(now())

  @@index([weekStart])
}

/// Homework / task a teacher assigns to a class (or specific students in it).
/// Recipients are materialised as `AssignmentSubmission` rows (one per student)
/// so completion + file submission are tracked per student.
model Assignment {
  id        String    @id @default(cuid())
  teacherId String
  classId   String
  title     String
  details   String? // plain-text description
  dueAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  teacher     Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class       Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  attachments Attachment[] // files the teacher attached (images / PDFs)
  submissions AssignmentSubmission[]

  @@index([teacherId])
  @@index([classId])
}

/// One student's instance of an assignment: their done state + submitted files.
model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  done         Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignment  Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attachments Attachment[] // files the student uploaded to submit

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

/// A student's own private to-do item (not assigned by a teacher).
model PersonalTodo {
  id          String    @id @default(cuid())
  studentId   String
  title       String
  details     String?
  dueAt       DateTime?
  done        Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

/// A stored file (image / PDF). Bytes live in the DB for portability across
/// SQLite↔Postgres and behind the reverse proxy (no filesystem dependency).
/// Linked to either an Assignment (teacher's files) or a Submission (student's).
model Attachment {
  id           String   @id @default(cuid())
  filename     String
  mime         String
  size         Int
  data         Bytes
  uploaderId   String // User.id who uploaded it
  assignmentId String?
  submissionId String?
  createdAt    DateTime @default(now())

  assignment Assignment?           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submission AssignmentSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([submissionId])
  @@index([uploaderId])
}

/// General security audit log (logins, role-sensitive actions, imports).
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metaJson  String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
