# Copy to .env and fill in. See README for details.

# SQLite (local dev):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production) — also flip provider to "postgresql" in schema.prisma:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/spk?schema=public"

# Sign session + CSRF tokens. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-value"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Google Sign-In (OAuth 2.0). Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ALLOWED_EMAIL_DOMAIN="suntisuk.ac.th"
# Optional auto-provision role for new domain users (ADMIN|TEACHER|STUDENT); empty = require existing account
GOOGLE_AUTO_PROVISION_ROLE=""

# Web Push. Generate: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@suntisuk.ac.th"
